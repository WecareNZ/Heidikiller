# Copy this file to .env and fill in your keys. Never commit .env.
# These are read by the Netlify Functions (server-side only) — they are
# NOT exposed to the browser.

# Anthropic API key — powers note/referral generation and the clinical chatbot.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram API key — powers live speech-to-text.
# Get one at https://console.deepgram.com/
# The browser never sees this key; a short-lived token is minted per session.
DEEPGRAM_API_KEY=...

# Supabase — stores your real HealthPathways / WeCare referral protocols.
# Server-side only (the function reads protocols with the service role key, so
# licensed content never reaches the browser). Leave blank to fall back to the
# public synthetic protocols in src/config/protocols.ts.
# Project settings → API. Use the SERVICE ROLE key (secret), not the anon key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
